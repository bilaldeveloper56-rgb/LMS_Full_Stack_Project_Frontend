# ==============================================================================
# Multi-Tenant School ERP & LMS SaaS - Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # 'development' | 'production' | 'test'
LOG_LEVEL=info # 'error' | 'warn' | 'info' | 'http' | 'debug'

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Local: mongodb://localhost:27017/school-erp
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school-erp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/school-erp

# ------------------------------------------------------------------------------
# 3. FRONTEND & CORS CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. JWT SECURITY CONFIGURATION (REQUIRED - MIN 32 CHARACTERS)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. COOKIE CONFIGURATION (REQUIRED FOR AUTHENTICATION)
# ------------------------------------------------------------------------------
# For cross-site deployments (e.g., Vercel frontend + Render backend):
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# For same-domain / same-site deployments:
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 6. TOKEN EXPIRATION WINDOWS (REQUIRED)
# ------------------------------------------------------------------------------
PASSWORD_RESET_EXPIRES_IN=10m
EMAIL_VERIFICATION_EXPIRES_IN=24h
INVITATION_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 7. SUPER ADMIN INITIAL SEED (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=superadmin@schoolerp.com
SUPER_ADMIN_PASSWORD=SuperAdmin@2026!
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=SuperAdmin

# ------------------------------------------------------------------------------
# 8. EMAIL SERVICE CONFIGURATION (REQUIRED FOR INVITATIONS & RESETS)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_FROM=no-reply@lmsprime.online
# SMTP Fallback (optional if RESEND_API_KEY is configured)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key

# ------------------------------------------------------------------------------
# 9. CLOUDINARY MEDIA STORAGE (OPTIONAL / REQUIRED FOR FILE UPLOADS)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 10. REDIS DISTRIBUTED CACHE & RATE LIMITING (OPTIONAL - FALLS BACK TO IN-MEMORY)
# ------------------------------------------------------------------------------
# Upstash or Redis Cloud URL format: rediss://default:<password>@<host>:<port>
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
